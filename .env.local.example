# Frontend development flags
VITE_API_PROXY_AVAILABLE=true
VITE_API_PROXY_LOCKED=true

# Backend local development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
DATABASE_URL=postgresql://gpt-image:replace-with-password@127.0.0.1:5432/gpt-image
JWT_SECRET=01234567890123456789012345678901
JWT_EXPIRES_IN_SECONDS=604800
IMAGE_STORAGE_PATH=.tmp-images

# Optional: development-only image API override for direct public-IP access.
# Use HTTP + Host header to bypass Cloudflare while still matching the upstream virtual host.
IMAGE_API_DEV_BASE_URL=http://47.80.7.170/v1
IMAGE_API_DEV_HOST_HEADER=codex.codelwt.cc.cd

# Used only when the database has no admin account yet.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123456
